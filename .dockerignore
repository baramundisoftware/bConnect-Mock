# Dependencies (re-installed in container)
node_modules/

# TypeScript source (compiled in builder stage, not needed in runtime)
# (src/ IS needed in builder stage, so we leave it — multi-stage handles this)

# Build artifacts (re-generated by `npm run build` in builder)
build/

# Test artefacts
coverage/
.nyc_output/

# Test files (not needed in production image)
tests/

# Dev/CI configuration (not needed at runtime)
.github/
.vscode/
.idea/
*.log
npm-debug.log*

# Environment files (use Docker env vars or --env-file instead)
.env
.env.*
!.env.example

# Git
.git/
.gitignore

# Documentation sources (rendered docs are served from docs/ which IS copied)
*.md
!README.md

# Scripts (not needed inside container)
scripts/

# Misc
*.tmp
*.swp
.DS_Store
Thumbs.db
