# bConnect Mock Server — Environment Variables
# Copy this file to .env and adjust values as needed.

# TCP port the server listens on (default: 3433)
PORT=3433

# Data profile to load.
# Options: minimal-readonly | minimal-readwrite | standard-readonly | standard-readwrite | largescale-readonly
BCONNECT_PROFILE=standard-readonly

# BMS version the mock should emulate.
# Options: 25r2 | 26r1 (default: 25r2)
BCONNECT_BMS_VERSION=25r2

# Log level: info | debug (default: info)
LOG_LEVEL=info

# Authentication — simulates bConnect API auth (disabled by default).
# When set, ALL requests must present valid credentials.
# Both methods can be enabled simultaneously (either is accepted).
# REQUIRE_API_KEY=your-api-key-here
# REQUIRE_BASIC_AUTH=username:password

# Rate limiting (disabled by default)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
